{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI-first project harness",
  "type": "object",
  "required": ["$schema", "schemaVersion", "project", "guidance", "knowledge", "commands", "validation", "architecture"],
  "properties": {
    "$schema": {"const": "./harness.schema.json"},
    "schemaVersion": {"const": 1},
    "project": {
      "type": "object",
      "required": ["name", "adoptionMode", "specPersistence"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "adoptionMode": {"enum": ["greenfield", "brownfield"]},
        "specPersistence": {"enum": ["living", "flow-forward", "flow-back"]}
      }
    },
    "guidance": {
      "type": "object",
      "required": ["entrypoint", "maxLines", "adapters"],
      "properties": {
        "entrypoint": {"type": "string"},
        "maxLines": {"type": "integer", "minimum": 20, "maximum": 400},
        "adapters": {"type": "object"}
      }
    },
    "knowledge": {
      "type": "object",
      "required": ["index", "architecture", "product"],
      "properties": {
        "index": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "product": {"type": "string", "minLength": 1},
        "agents": {"type": "string", "minLength": 1},
        "tasks": {"type": "string", "minLength": 1},
        "plans": {"type": "string", "minLength": 1},
        "operations": {"type": "string", "minLength": 1},
        "quality": {"type": "string", "minLength": 1},
        "generated": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "commands": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["argv"],
          "properties": {
            "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "cwd": {"type": "string", "minLength": 1},
            "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 7200},
            "required": {"type": "boolean"}
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "required": ["freshnessDays", "requiredChecks"],
      "properties": {
        "freshnessDays": {"type": "integer", "minimum": 1},
        "requiredChecks": {"type": "array", "items": {"type": "string"}}
      }
    },
    "architecture": {
      "type": "object",
      "required": ["enforced", "zones"],
      "properties": {
        "enforced": {"type": "boolean"},
        "zones": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "paths", "mayDependOn"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "mayDependOn": {"type": "array", "items": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
